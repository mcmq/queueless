# Queueless environment template.
# Copy to `.env` and fill in your own values:  cp .env.example .env
# `.env` is git-ignored; only this example file is committed.
#
# Where to find the values:
#   Firebase console -> Project settings -> General -> "Your apps"
#   (or run `flutterfire configure`, which writes lib/firebase_options.dart
#   with the same values).

# Firebase project ID (Project settings -> General -> Project ID)
FIREBASE_PROJECT_ID=your-project-id

# Cloud Messaging sender ID / project number (Project settings -> Cloud Messaging)
FIREBASE_MESSAGING_SENDER_ID=000000000000

# Default storage bucket, e.g. your-project-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Android app: "apiKey" and "appId" from google-services.json
# (current_key / mobilesdk_app_id)
FIREBASE_ANDROID_API_KEY=your-android-api-key
FIREBASE_ANDROID_APP_ID=1:000000000000:android:xxxxxxxxxxxxxxxx

# iOS app: API_KEY and GOOGLE_APP_ID from GoogleService-Info.plist
FIREBASE_IOS_API_KEY=your-ios-api-key
FIREBASE_IOS_APP_ID=1:000000000000:ios:xxxxxxxxxxxxxxxx

# iOS bundle identifier (BUNDLE_ID in GoogleService-Info.plist)
FIREBASE_IOS_BUNDLE_ID=com.example.queueless

# Optional: used only by `dart run tool/seed_demo.dart <web-api-key> <project-id>`
# (pass the API key and project ID above as arguments).
